{
  "name": "@fiorejs/jsx",
  "version": "2.0.0",
  "description": "JSX runtime for fiorejs. Write HTML and SVG as JSX and get real DOM nodes, with no virtual DOM and no re-rendering.",
  "license": "MIT",
  "author": "vrtexe",
  "type": "module",
  "keywords": [
    "fiore",
    "fiorejs",
    "jsx",
    "jsx-runtime",
    "dom",
    "html",
    "svg",
    "typescript"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./jsx-runtime": {
      "types": "./src/jsx-runtime.d.ts",
      "default": "./src/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./src/jsx-dev-runtime.d.ts",
      "default": "./src/jsx-dev-runtime.js"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "tsc -p test && tsc -p test/plain && node --test test/out/render.test.js"
  },
  "peerDependencies": {
    "fiorejs": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/vrtexe/fiore/tree/main/packages/jsx#readme",
  "bugs": {
    "url": "https://github.com/vrtexe/fiore/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vrtexe/fiore.git",
    "directory": "packages/jsx"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "fiorejs": "file:../..",
    "jsdom": "^31.0.1",
    "typescript": "~5.9"
  }
}
